# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2

# When set, POST /assess, POST /api/assessments/stream, GET /api/assessments*
# and pilot.zip downloads require header: X-Demo-Token: <value>
DEMO_TOKEN=

RATE_LIMIT_PER_HOUR=5
MAX_SITUATION_CHARS=4000
DATA_DIR=./data
LOG_LEVEL=INFO

# development | production  (production refuses to start without GROQ_API_KEY and DEMO_TOKEN)
ENV=development

# Copy to .env and fill in. Never commit .env.

# Required to run an assessment. Production refuses to start if this is empty.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2

# When set, POST /assess, POST /api/assessments/stream, GET /api/assessments*
# and pilot.zip downloads require header: X-Demo-Token: <value>
# Required when ENV=production.
DEMO_TOKEN=

RATE_LIMIT_PER_HOUR=5
MAX_SITUATION_CHARS=4000
DATA_DIR=./data
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# development | production  (production refuses to start without GROQ_API_KEY and DEMO_TOKEN)
ENV=development

# Set true only behind a trusted platform proxy (Fly.io, Railway) that sets X-Forwarded-For.
# Default false: the rate limiter uses the TCP peer and ignores the header (prevents spoofing).
TRUSTED_PROXY=false

# Comma-separated browser origins allowed to call the API. Empty = same-origin only (recommended).
CORS_ORIGINS=

# LLM call budget. Retries use exponential backoff (backoff, 2x, 4x, ...).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
